class CursoDAO implements ICursoDAO {
    private $db;
    
    public function __construct() {
        $this->db = Database::getInstance()->getConnection();
    }
    
    public function crear(Curso $curso) {
        $sql = "INSERT INTO cursos (titulo, descripcion, duracion_horas, empresa_id, activo, fecha_creacion) 
                VALUES (:titulo, :descripcion, :duracion, :empresa_id, :activo, :fecha_creacion)";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([
                ':titulo' => $curso->getTitulo(),
                ':descripcion' => $curso->getDescripcion(),
                ':duracion' => $curso->getDuracionHoras(),
                ':empresa_id' => $curso->getEmpresaId(),
                ':activo' => $curso->isActivo() ? 1 : 0,
                ':fecha_creacion' => $curso->getFechaCreacion()
            ]);
            
            $curso->setId($this->db->lastInsertId());
            return $curso;
        } catch(PDOException $e) {
            throw new Exception("Error al crear curso: " . $e->getMessage());
        }
    }
    
    public function obtenerPorId($id) {
        $sql = "SELECT * FROM cursos WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':id' => $id]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if ($row) {
                return $this->mapearCurso($row);
            }
            return null;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener curso: " . $e->getMessage());
        }
    }
    
    public function obtenerTodos() {
        $sql = "SELECT * FROM cursos ORDER BY fecha_creacion DESC";
        
        try {
            $stmt = $this->db->query($sql);
            $cursos = [];
            
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $cursos[] = $this->mapearCurso($row);
            }
            
            return $cursos;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener cursos: " . $e->getMessage());
        }
    }
    
    public function obtenerPorEmpresa($empresa_id) {
        $sql = "SELECT * FROM cursos WHERE empresa_id = :empresa_id ORDER BY fecha_creacion DESC";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':empresa_id' => $empresa_id]);
            $cursos = [];
            
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $cursos[] = $this->mapearCurso($row);
            }
            
            return $cursos;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener cursos de empresa: " . $e->getMessage());
        }
    }
    
    public function actualizar(Curso $curso) {
        $sql = "UPDATE cursos SET titulo = :titulo, descripcion = :descripcion, 
                duracion_horas = :duracion, activo = :activo, fecha_actualizacion = NOW() 
                WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            return $stmt->execute([
                ':titulo' => $curso->getTitulo(),
                ':descripcion' => $curso->getDescripcion(),
                ':duracion' => $curso->getDuracionHoras(),
                ':activo' => $curso->isActivo() ? 1 : 0,
                ':id' => $curso->getId()
            ]);
        } catch(PDOException $e) {
            throw new Exception("Error al actualizar curso: " . $e->getMessage());
        }
    }
    
    public function eliminar($id) {
        $sql = "UPDATE cursos SET activo = 0 WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            return $stmt->execute([':id' => $id]);
        } catch(PDOException $e) {
            throw new Exception("Error al eliminar curso: " . $e->getMessage());
        }
    }
    
    public function obtenerActivos() {
        $sql = "SELECT * FROM cursos WHERE activo = 1 ORDER BY fecha_creacion DESC";
        
        try {
            $stmt = $this->db->query($sql);
            $cursos = [];
            
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $cursos[] = $this->mapearCurso($row);
            }
            
            return $cursos;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener cursos activos: " . $e->getMessage());
        }
    }
    
    private function mapearCurso($row) {
        $curso = new Curso();
        $curso->setId($row['id']);
        $curso->setTitulo($row['titulo']);
        $curso->setDescripcion($row['descripcion']);
        $curso->setDuracionHoras($row['duracion_horas']);
        $curso->setEmpresaId($row['empresa_id']);
        $curso->setActivo($row['activo']);
        $curso->setFechaCreacion($row['fecha_creacion']);
        $curso->setFechaActualizacion($row['fecha_actualizacion'] ?? null);
        return $curso;
    }
}

class InscripcionDAO implements IInscripcionDAO {
    private $db;
    
    public function __construct() {
        $this->db = Database::getInstance()->getConnection();
    }
    
    public function crear(Inscripcion $inscripcion) {
        $sql = "INSERT INTO inscripciones (curso_id, usuario_id, fecha_inscripcion, progreso, estado) 
                VALUES (:curso_id, :usuario_id, :fecha_inscripcion, :progreso, :estado)";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([
                ':curso_id' => $inscripcion->getCursoId(),
                ':usuario_id' => $inscripcion->getUsuarioId(),
                ':fecha_inscripcion' => $inscripcion->getFechaInscripcion(),
                ':progreso' => $inscripcion->getProgreso(),
                ':estado' => $inscripcion->getEstado()
            ]);
            
            $inscripcion->setId($this->db->lastInsertId());
            return $inscripcion;
        } catch(PDOException $e) {
            throw new Exception("Error al crear inscripción: " . $e->getMessage());
        }
    }
    
    public function obtenerPorId($id) {
        $sql = "SELECT * FROM inscripciones WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':id' => $id]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if ($row) {
                return $this->mapearInscripcion($row);
            }
            return null;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener inscripción: " . $e->getMessage());
        }
    }
    
    public function obtenerPorUsuario($usuario_id) {
        $sql = "SELECT i.*, c.titulo as curso_titulo, c.descripcion as curso_descripcion 
                FROM inscripciones i 
                INNER JOIN cursos c ON i.curso_id = c.id 
                WHERE i.usuario_id = :usuario_id 
                ORDER BY i.fecha_inscripcion DESC";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':usuario_id' => $usuario_id]);
            $inscripciones = [];
            
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $inscripciones[] = $this->mapearInscripcion($row);
            }
            
            return $inscripciones;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener inscripciones: " . $e->getMessage());
        }
    }
    
    public function obtenerPorCurso($curso_id) {
        $sql = "SELECT * FROM inscripciones WHERE curso_id = :curso_id";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':curso_id' => $curso_id]);
            $inscripciones = [];
            
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $inscripciones[] = $this->mapearInscripcion($row);
            }
            
            return $inscripciones;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener inscripciones del curso: " . $e->getMessage());
        }
    }
    
    public function actualizar(Inscripcion $inscripcion) {
        $sql = "UPDATE inscripciones SET progreso = :progreso, estado = :estado, 
                fecha_inicio = :fecha_inicio, fecha_completado = :fecha_completado 
                WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            return $stmt->execute([
                ':progreso' => $inscripcion->getProgreso(),
                ':estado' => $inscripcion->getEstado(),
                ':fecha_inicio' => $inscripcion->getFechaInicio(),
                ':fecha_completado' => $inscripcion->getFechaCompletado(),
                ':id' => $inscripcion->getId()
            ]);
        } catch(PDOException $e) {
            throw new Exception("Error al actualizar inscripción: " . $e->getMessage());
        }
    }
    
    public function verificarInscripcion($usuario_id, $curso_id) {
        $sql = "SELECT * FROM inscripciones WHERE usuario_id = :usuario_id AND curso_id = :curso_id";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([
                ':usuario_id' => $usuario_id,
                ':curso_id' => $curso_id
            ]);
            
            return $stmt->fetch(PDO::FETCH_ASSOC) ? true : false;
        } catch(PDOException $e) {
            throw new Exception("Error al verificar inscripción: " . $e->getMessage());
        }
    }
    
    public function actualizarProgreso($id, $progreso) {
        $sql = "UPDATE inscripciones SET progreso = :progreso, estado = 'en_progreso' WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            return $stmt->execute([
                ':progreso' => $progreso,
                ':id' => $id
            ]);
        } catch(PDOException $e) {
            throw new Exception("Error al actualizar progreso: " . $e->getMessage());
        }
    }
    
    public function completarCurso($id) {
        $sql = "UPDATE inscripciones SET progreso = 100, estado = 'completado', 
                fecha_completado = NOW() WHERE id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            return $stmt->execute([':id' => $id]);
        } catch(PDOException $e) {
            throw new Exception("Error al completar curso: " . $e->getMessage());
        }
    }
    
    private function mapearInscripcion($row) {
        $inscripcion = new Inscripcion();
        $inscripcion->setId($row['id']);
        $inscripcion->setCursoId($row['curso_id']);
        $inscripcion->setUsuarioId($row['usuario_id']);
        $inscripcion->setFechaInscripcion($row['fecha_inscripcion']);
        $inscripcion->setFechaInicio($row['fecha_inicio'] ?? null);
        $inscripcion->setFechaCompletado($row['fecha_completado'] ?? null);
        $inscripcion->setProgreso($row['progreso']);
        $inscripcion->setEstado($row['estado']);
        return $inscripcion;
    }
}

class CertificadoDAO implements ICertificadoDAO {
    private $db;
    
    public function __construct() {
        $this->db = Database::getInstance()->getConnection();
    }
    
    public function crear(Certificado $certificado) {
        $sql = "INSERT INTO certificados (codigo_unico, inscripcion_id, usuario_id, curso_id, fecha_emision, url_validacion) 
                VALUES (:codigo, :inscripcion_id, :usuario_id, :curso_id, :fecha_emision, :url_validacion)";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([
                ':codigo' => $certificado->getCodigoUnico(),
                ':inscripcion_id' => $certificado->getInscripcionId(),
                ':usuario_id' => $certificado->getUsuarioId(),
                ':curso_id' => $certificado->getCursoId(),
                ':fecha_emision' => $certificado->getFechaEmision(),
                ':url_validacion' => $certificado->getUrlValidacion()
            ]);
            
            $certificado->setId($this->db->lastInsertId());
            return $certificado;
        } catch(PDOException $e) {
            throw new Exception("Error al crear certificado: " . $e->getMessage());
        }
    }
    
    public function obtenerPorId($id) {
        $sql = "SELECT c.*, cu.titulo as curso_titulo, u.nombre as usuario_nombre 
                FROM certificados c 
                INNER JOIN cursos cu ON c.curso_id = cu.id 
                INNER JOIN usuarios u ON c.usuario_id = u.id 
                WHERE c.id = :id";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':id' => $id]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if ($row) {
                return $this->mapearCertificado($row);
            }
            return null;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener certificado: " . $e->getMessage());
        }
    }
    
    public function obtenerPorCodigo($codigo) {
        $sql = "SELECT c.*, cu.titulo as curso_titulo, u.nombre as usuario_nombre 
                FROM certificados c 
                INNER JOIN cursos cu ON c.curso_id = cu.id 
                INNER JOIN usuarios u ON c.usuario_id = u.id 
                WHERE c.codigo_unico = :codigo";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':codigo' => $codigo]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if ($row) {
                return $this->mapearCertificado($row);
            }
            return null;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener certificado por código: " . $e->getMessage());
        }
    }
    
    public function obtenerPorUsuario($usuario_id) {
        $sql = "SELECT c.*, cu.titulo as curso_titulo 
                FROM certificados c 
                INNER JOIN cursos cu ON c.curso_id = cu.id 
                WHERE c.usuario_id = :usuario_id 
                ORDER BY c.fecha_emision DESC";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':usuario_id' => $usuario_id]);
            $certificados = [];
            
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $certificados[] = $this->mapearCertificado($row);
            }
            
            return $certificados;
        } catch(PDOException $e) {
            throw new Exception("Error al obtener certificados del usuario: " . $e->getMessage());
        }
    }
    
    public function verificarCertificado($codigo) {
        $sql = "SELECT c.*, cu.titulo as curso_titulo, u.nombre as usuario_nombre, 
                cu.duracion_horas, e.nombre as empresa_nombre 
                FROM certificados c 
                INNER JOIN cursos cu ON c.curso_id = cu.id 
                INNER JOIN usuarios u ON c.usuario_id = u.id 
                INNER JOIN empresas e ON cu.empresa_id = e.id 
                WHERE c.codigo_unico = :codigo";
        
        try {
            $stmt = $this->db->prepare($sql);
            $stmt->execute([':codigo' => $codigo]);
            return $stmt->fetch(PDO::FETCH_ASSOC);
        } catch(PDOException $e) {
            throw new Exception("Error al verificar certificado: " . $e->getMessage());
        }
    }
    
    private function mapearCertificado($row) {
        $certificado = new Certificado();
        $certificado->setId($row['id']);
        $certificado->setCodigoUnico($row['codigo_unico']);
        $certificado->setInscripcionId($row['inscripcion_id']);
        $certificado->setUsuarioId($row['usuario_id']);
        $certificado->setCursoId($row['curso_id']);
        $certificado->setFechaEmision($row['fecha_emision']);
        $certificado->setUrlValidacion($row['url_validacion'] ?? null);
        return $certificado;
    }
}

