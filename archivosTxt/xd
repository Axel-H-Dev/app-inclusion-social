class CursoService {
    private $cursoDAO;
    private $inscripcionDAO;
    private $certificadoDAO;
    
    public function __construct() {
        $this->cursoDAO = new CursoDAO();
        $this->inscripcionDAO = new InscripcionDAO();
        $this->certificadoDAO = new CertificadoDAO();
    }
    
    public function crearCurso($titulo, $descripcion, $duracion_horas, $empresa_id) {
        $curso = new Curso();
        $curso->setTitulo($titulo);
        $curso->setDescripcion($descripcion);
        $curso->setDuracionHoras($duracion_horas);
        $curso->setEmpresaId($empresa_id);
        
        return $this->cursoDAO->crear($curso);
    }
    
    public function inscribirUsuario($usuario_id, $curso_id) {
        // Verificar si ya está inscrito
        if ($this->inscripcionDAO->verificarInscripcion($usuario_id, $curso_id)) {
            throw new Exception("El usuario ya está inscrito en este curso");
        }
        
        $inscripcion = new Inscripcion();
        $inscripcion->setUsuarioId($usuario_id);
        $inscripcion->setCursoId($curso_id);
        
        return $this->inscripcionDAO->crear($inscripcion);
    }
    
    public function completarCurso($inscripcion_id, $usuario_id, $curso_id) {
        // Completar la inscripción
        $this->inscripcionDAO->completarCurso($inscripcion_id);
        
        // Generar certificado
        $certificado = new Certificado();
        $certificado->setInscripcionId($inscripcion_id);
        $certificado->setUsuarioId($usuario_id);
        $certificado->setCursoId($curso_id);
        $certificado->setUrlValidacion("/verificar-certificado.php?codigo=" . $certificado->getCodigoUnico());
        
        return $this->certificadoDAO->crear($certificado);
    }
    
    public function obtenerCursosDisponibles() {
        return $this->cursoDAO->obtenerActivos();
    }
    
    public function obtenerMisCursos($usuario_id) {
        return $this->inscripcionDAO->obtenerPorUsuario($usuario_id);
    }
    
    public function obtenerMisCertificados($usuario_id) {
        return $this->certificadoDAO->obtenerPorUsuario($usuario_id);
    }
    
    public function actualizarProgresoCurso($inscripcion_id, $progreso) {
        if ($progreso < 0 || $progreso > 100) {
            throw new Exception("El progreso debe estar entre 0 y 100");
        }
        
        if ($progreso == 100) {
            // Si el progreso es 100%, completar el curso
            $inscripcion = $this->inscripcionDAO->obtenerPorId($inscripcion_id);
            if ($inscripcion) {
                return $this->completarCurso(
                    $inscripcion_id, 
                    $inscripcion->getUsuarioId(), 
                    $inscripcion->getCursoId()
                );
            }
        } else {
            return $this->inscripcionDAO->actualizarProgreso($inscripcion_id, $progreso);
        }
    }
}

