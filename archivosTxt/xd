// Entidad Certificado
class Certificado {
    private $id;
    private $codigo_unico;
    private $inscripcion_id;
    private $usuario_id;
    private $curso_id;
    private $fecha_emision;
    private $url_validacion;
    
    public function __construct() {
        $this->codigo_unico = $this->generarCodigoUnico();
        $this->fecha_emision = date('Y-m-d H:i:s');
    }
    
    private function generarCodigoUnico() {
        return strtoupper(substr(md5(uniqid(mt_rand(), true)), 0, 12));
    }
    
    // Getters
    public function getId() { return $this->id; }
    public function getCodigoUnico() { return $this->codigo_unico; }
    public function getInscripcionId() { return $this->inscripcion_id; }
    public function getUsuarioId() { return $this->usuario_id; }
    public function getCursoId() { return $this->curso_id; }
    public function getFechaEmision() { return $this->fecha_emision; }
    public function getUrlValidacion() { return $this->url_validacion; }
    
    // Setters
    public function setId($id) { $this->id = $id; }
    public function setCodigoUnico($codigo) { $this->codigo_unico = $codigo; }
    public function setInscripcionId($id) { $this->inscripcion_id = $id; }
    public function setUsuarioId($id) { $this->usuario_id = $id; }
    public function setCursoId($id) { $this->curso_id = $id; }
    public function setFechaEmision($fecha) { $this->fecha_emision = $fecha; }
    public function setUrlValidacion($url) { $this->url_validacion = $url; }
}

